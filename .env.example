# PostgreSQL 접속 문자열 (필수). 예: postgres://arena:비밀번호@localhost:5432/arena
DATABASE_URL=postgres://arena:change-me@localhost:5432/arena

# 커넥션 풀 최대 커넥션 수 (선택, 기본 10)
# PGPOOL_MAX=10

# 세션(JWT 쿠키) 서명용 시크릿. 운영(NODE_ENV=production)에서는 필수 — 없으면 기동에 실패한다.
AUTH_SECRET=change-me-to-a-long-random-string

# 업로드 첨부파일이 쌓이는 디렉토리 (선택, 기본 ./data)
# DATA_DIR=/data

# 운영자가 한 명도 없을 때 최초 1회 생성되는 운영자 계정.
# SEED_ADMIN_PASSWORD 가 없으면 계정을 만들지 않고 에러를 낸다(기본 비밀번호를 두지 않기 위함).
SEED_ADMIN_EMAIL=admin@seoularena.net
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# 이 이메일로 이미 가입된 계정을 마스터 관리자로 승격한다(콤마로 여러 명 지정 가능).
# 신청자로 가입한 계정이었다면 운영자로도 함께 전환된다. 서버가 재시작될 때마다 확인하므로
# 아직 가입 전이어도 나중에 그 이메일로 가입하면 다음 재시작 때 자동으로 승격된다.
# MASTER_ADMIN_EMAILS=admin@seoularena.net

# 내부 테스트용 신청자 계정 — 아래 두 값을 모두 준 경우에만 생성된다(운영에서는 설정하지 말 것).
# SEED_TEST_APPLICANT_EMAIL=test@seoularena.net
# SEED_TEST_APPLICANT_USERNAME=test
# SEED_TEST_APPLICANT_PASSWORD=
