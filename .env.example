# PostgreSQL 접속 문자열. 미설정 시 로컬 개발 기본값
# postgres://postgres:postgres@localhost:5433/seoularena 가 사용된다 (docker-compose.yml 참고).
# 자체 서명 인증서를 쓰는 관리형 DB에 외부 접속할 때는 DATABASE_SSL=true 또는 URL에 sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/seoularena
# DATABASE_SSL=true

# 세션 서명용 시크릿. 운영(production) 환경에서는 미설정 시 서버가 기동을 거부한다.
AUTH_SECRET=change-me-to-a-long-random-string

# 최초 실행 시 자동 생성되는 운영자 계정 (미설정 시 기본값 admin@seoularena.kr / admin1234!)
SEED_ADMIN_EMAIL=admin@seoularena.kr
SEED_ADMIN_PASSWORD=admin1234!

# 이 이메일로 이미 가입된 계정을 마스터 관리자로 승격한다(콤마로 여러 명 지정 가능).
# 신청자로 가입한 계정이었다면 운영자로도 함께 전환된다. 서버가 재시작될 때마다 확인하므로
# 아직 가입 전이어도 나중에 그 이메일로 가입하면 다음 재시작 때 자동으로 승격된다.
# MASTER_ADMIN_EMAILS=niki.arena@kakaocorp.com,admin@seoularena.kr
