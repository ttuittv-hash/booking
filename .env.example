# PostgreSQL 접속 문자열. 미설정 시 로컬 개발 기본값
# postgres://postgres:postgres@localhost:5433/seoularena 가 사용된다 (docker-compose.yml 참고).
# 자체 서명 인증서를 쓰는 관리형 DB에 외부 접속할 때는 DATABASE_SSL=true 또는 URL에 sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/seoularena
# DATABASE_SSL=true

# 세션 서명용 시크릿. 운영(production) 환경에서는 미설정 시 서버가 기동을 거부한다.
AUTH_SECRET=change-me-to-a-long-random-string

# 운영자가 한 명도 없을 때 최초 1회 자동 생성되는 운영자 계정.
# 운영(NODE_ENV=production)에서는 SEED_ADMIN_PASSWORD 미설정 시 기동에 실패한다
# (기본 비밀번호를 두지 않기 위함). 개발 환경 기본값: admin / admin1234!
SEED_ADMIN_EMAIL=admin@seoularena.kr
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# 내부 테스트용 신청자 계정 — 개발 환경에서는 test/test1234!로 자동 생성되지만,
# 운영에서는 SEED_TEST_APPLICANT_PASSWORD를 지정한 경우에만 생성된다.
# SEED_TEST_APPLICANT_EMAIL=test@seoularena.kr
# SEED_TEST_APPLICANT_USERNAME=test
# SEED_TEST_APPLICANT_PASSWORD=

# 이 이메일로 이미 가입된 계정을 마스터 관리자로 승격한다(콤마로 여러 명 지정 가능).
# 신청자로 가입한 계정이었다면 운영자로도 함께 전환된다. 서버가 재시작될 때마다 확인하므로
# 아직 가입 전이어도 나중에 그 이메일로 가입하면 다음 재시작 때 자동으로 승격된다.
# MASTER_ADMIN_EMAILS=niki.arena@kakaocorp.com,admin@seoularena.kr

# 사업자 진위확인 (NICE평가정보 「NICE아이디 — 법인실명확인」)
# 설정하지 않으면 확인을 건너뛰고 가입은 그대로 진행된다("미확인"으로 기록).
# 접근 IP 제한이 걸린 서비스라, 이용기관 포털에 서버 아웃바운드 IP를 등록해야 한다.
# NICE_CLIENT_ID=
# NICE_CLIENT_SECRET=
# NICE_PRODUCT_ID=2101764012        # 법인실명확인 상품코드 (기본값)
# NICE_API_BASE_URL=https://svc.niceapi.co.kr:22001
